{
  "name": "claude-a1",
  "command": "claude",
  "args": [
    "-p",
    "--input-format",
    "text",
    "--output-format",
    "stream-json",
    "--verbose",
    "--mcp-config",
    "$CONFIG/claude-mcp.json",
    "--strict-mcp-config",
    "--setting-sources",
    "user",
    "--settings",
    "$CONFIG/claude-settings.json",
    "--allowedTools",
    "mcp__platform__*",
    "Bash",
    "--permission-mode",
    "acceptEdits"
  ],
  "dir": "$WORK",
  "env_extra": [
    "CLAUDE_CODE_SUBPROCESS_ENV_SCRUB=1"
  ],
  "stdin": "do the ticket",
  "provider_environment": [
    "CLAUDE_CONFIG_DIR=/home/runner/.claude-config"
  ],
  "managed_config_mounts": null,
  "config_files": [
    {
      "name": "claude-mcp.json",
      "mode": "-rw-------",
      "content": "{\n  \"mcpServers\": {\n    \"platform\": {\n      \"args\": [\n        \"mcp-serve\",\n        \"--socket\",\n        \"/run/runner/job.sock\",\n        \"--token-file\",\n        \"/run/runner/job.token\"\n      ],\n      \"command\": \"/usr/local/bin/our-runner\",\n      \"timeout\": 27180000\n    }\n  }\n}"
    },
    {
      "name": "claude-settings.json",
      "mode": "-rw-------",
      "content": "{\n  \"hooks\": {\n    \"Notification\": [\n      {\n        \"hooks\": [\n          {\n            \"command\": \"'$CONFIG/managed-hook-notification'\",\n            \"timeout\": 2,\n            \"type\": \"command\"\n          }\n        ]\n      }\n    ],\n    \"PostToolUse\": [\n      {\n        \"hooks\": [\n          {\n            \"command\": \"'$CONFIG/managed-hook-post-tool'\",\n            \"timeout\": 2,\n            \"type\": \"command\"\n          }\n        ]\n      }\n    ],\n    \"PostToolUseFailure\": [\n      {\n        \"hooks\": [\n          {\n            \"command\": \"'$CONFIG/managed-hook-tool-error'\",\n            \"timeout\": 2,\n            \"type\": \"command\"\n          }\n        ]\n      }\n    ],\n    \"PreToolUse\": [\n      {\n        \"hooks\": [\n          {\n            \"command\": \"'$CONFIG/managed-hook-pre-tool'\",\n            \"timeout\": 2,\n            \"type\": \"command\"\n          }\n        ]\n      }\n    ],\n    \"SessionEnd\": [\n      {\n        \"hooks\": [\n          {\n            \"command\": \"'$CONFIG/managed-hook-session-end'\",\n            \"timeout\": 2,\n            \"type\": \"command\"\n          }\n        ]\n      }\n    ],\n    \"SessionStart\": [\n      {\n        \"hooks\": [\n          {\n            \"command\": \"'$CONFIG/managed-hook-session-start'\",\n            \"timeout\": 2,\n            \"type\": \"command\"\n          }\n        ]\n      }\n    ],\n    \"Stop\": [\n      {\n        \"hooks\": [\n          {\n            \"command\": \"'$CONFIG/managed-hook-stop'\",\n            \"timeout\": 2,\n            \"type\": \"command\"\n          }\n        ]\n      }\n    ],\n    \"SubagentStop\": [\n      {\n        \"hooks\": [\n          {\n            \"command\": \"'$CONFIG/managed-hook-subagent-stop'\",\n            \"timeout\": 2,\n            \"type\": \"command\"\n          }\n        ]\n      }\n    ],\n    \"UserPromptSubmit\": [\n      {\n        \"hooks\": [\n          {\n            \"command\": \"'$CONFIG/managed-hook-user-prompt-submit'\",\n            \"timeout\": 2,\n            \"type\": \"command\"\n          }\n        ]\n      }\n    ]\n  },\n  \"permissions\": {\n    \"allow\": [\n      \"Read(/$PACK/**)\"\n    ],\n    \"deny\": [\n      \"Read(~/.claude/**)\",\n      \"Edit(~/.claude/**)\",\n      \"Read(~/.claude.json)\",\n      \"Edit(~/.claude.json)\",\n      \"Read(//home/runner/.claude-config/**)\",\n      \"Edit(//home/runner/.claude-config/**)\"\n    ]\n  },\n  \"sandbox\": {\n    \"allowUnsandboxedCommands\": false,\n    \"credentials\": {\n      \"files\": [\n        {\n          \"mode\": \"deny\",\n          \"path\": \"~/.claude/.credentials.json\"\n        },\n        {\n          \"mode\": \"deny\",\n          \"path\": \"~/.claude.json\"\n        },\n        {\n          \"mode\": \"deny\",\n          \"path\": \"/home/runner/.claude-config/.credentials.json\"\n        },\n        {\n          \"mode\": \"deny\",\n          \"path\": \"/home/runner/.claude-config/.claude.json\"\n        }\n      ]\n    },\n    \"enabled\": true,\n    \"failIfUnavailable\": true,\n    \"filesystem\": {\n      \"denyRead\": [\n        \"~/.claude\",\n        \"~/.claude.json\",\n        \"/home/runner/.claude-config\"\n      ],\n      \"denyWrite\": [\n        \"~/.claude\",\n        \"~/.claude.json\",\n        \"/home/runner/.claude-config\"\n      ]\n    },\n    \"network\": {\n      \"allowedDomains\": [],\n      \"strictAllowlist\": true\n    }\n  }\n}"
    },
    {
      "name": "managed-hook-notification",
      "mode": "-r-x------",
      "content": "#!/bin/sh\n'/usr/local/bin/our-runner' hook-event --socket '/run/runner/job.sock' --token-file '/run/runner/job.token' --type 'notification' \u003c/dev/null \u003e/dev/null 2\u003e\u00261\nexit 0\n"
    },
    {
      "name": "managed-hook-post-tool",
      "mode": "-r-x------",
      "content": "#!/bin/sh\n'/usr/local/bin/our-runner' hook-event --socket '/run/runner/job.sock' --token-file '/run/runner/job.token' --type 'post-tool' \u003c/dev/null \u003e/dev/null 2\u003e\u00261\nexit 0\n"
    },
    {
      "name": "managed-hook-pre-tool",
      "mode": "-r-x------",
      "content": "#!/bin/sh\n'/usr/local/bin/our-runner' hook-event --socket '/run/runner/job.sock' --token-file '/run/runner/job.token' --type 'pre-tool' \u003c/dev/null \u003e/dev/null 2\u003e\u00261\nexit 0\n"
    },
    {
      "name": "managed-hook-session-end",
      "mode": "-r-x------",
      "content": "#!/bin/sh\n'/usr/local/bin/our-runner' hook-event --socket '/run/runner/job.sock' --token-file '/run/runner/job.token' --type 'session-end' \u003c/dev/null \u003e/dev/null 2\u003e\u00261\nexit 0\n"
    },
    {
      "name": "managed-hook-session-start",
      "mode": "-r-x------",
      "content": "#!/bin/sh\n'/usr/local/bin/our-runner' hook-event --socket '/run/runner/job.sock' --token-file '/run/runner/job.token' --type 'session-start' \u003c/dev/null \u003e/dev/null 2\u003e\u00261\nexit 0\n"
    },
    {
      "name": "managed-hook-stop",
      "mode": "-r-x------",
      "content": "#!/bin/sh\n'/usr/local/bin/our-runner' hook-event --socket '/run/runner/job.sock' --token-file '/run/runner/job.token' --type 'stop' \u003c/dev/null \u003e/dev/null 2\u003e\u00261\nexit 0\n"
    },
    {
      "name": "managed-hook-subagent-stop",
      "mode": "-r-x------",
      "content": "#!/bin/sh\n'/usr/local/bin/our-runner' hook-event --socket '/run/runner/job.sock' --token-file '/run/runner/job.token' --type 'subagent-stop' \u003c/dev/null \u003e/dev/null 2\u003e\u00261\nexit 0\n"
    },
    {
      "name": "managed-hook-tool-error",
      "mode": "-r-x------",
      "content": "#!/bin/sh\n'/usr/local/bin/our-runner' hook-event --socket '/run/runner/job.sock' --token-file '/run/runner/job.token' --type 'tool-error' \u003c/dev/null \u003e/dev/null 2\u003e\u00261\nexit 0\n"
    },
    {
      "name": "managed-hook-user-prompt-submit",
      "mode": "-r-x------",
      "content": "#!/bin/sh\n'/usr/local/bin/our-runner' hook-event --socket '/run/runner/job.sock' --token-file '/run/runner/job.token' --type 'user-prompt-submit' \u003c/dev/null \u003e/dev/null 2\u003e\u00261\nexit 0\n"
    }
  ]
}
