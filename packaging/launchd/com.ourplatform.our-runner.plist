<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.ourplatform.our-runner</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/our-runner</string>
        <string>start</string>
        <string>--config</string>
        <string>/etc/our-runner/config.yaml</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>ThrottleInterval</key>
    <integer>5</integer>
    <key>WorkingDirectory</key>
    <string>/var/lib/our-runner</string>
    <key>StandardOutPath</key>
    <string>/var/log/our-runner/stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/var/log/our-runner/stderr.log</string>
</dict>
</plist>
